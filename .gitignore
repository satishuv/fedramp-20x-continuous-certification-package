# Credentials and secrets: never commit
*.pem
*.key
*.p12
*.pfx
.env
.env.*
credentials*
*credential*
aws-exports*

# Raw evidence and customer material: never commit
evidence/
raw-evidence/
customer-*/
*-customer-*
overrides/
# Customer custom Config-rule overlay (their rule names are their data)
automation/config-rules/customer-config-rules.json

# Python caches
__pycache__/
*.pyc
*.pyo

# Office temp files
~$*
*.tmp

# Editor and OS clutter
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local build logs
*.log

# Local working notes: session logs and dated review reports contain
# engagement context (names, local paths) and stay out of the public repo.
# Remove these two lines only after scrubbing the files.
steering/
quality/

# Collected facts identify a real AWS account: never commit
automation/facts/

# The pre-fill sidecar is a proposed record store derived from collected facts.
# It is a working artifact to diff against, not a deliverable: never commit.
sdr/records/records-store.prefilled.json

# Per-KSI daily metric history derives from a real account: never commit.
automation/metrics/metric-history.json

# The release attestation is release-only: it names a specific git commit/tree
# and binds the deterministic manifest's hash to that source. It is produced at
# release/publish time (sdr.py release) and uploaded as a build artifact, not
# committed (a committed one would name its own pre-commit hash and trip the CI
# regenerate-and-diff gate).
artifacts/release-attestation.json

# The assembled customer bundle is release-only (produced at publish time by
# assemble_release_bundle.py, active-class-only). Uploaded as a build artifact,
# not committed.
artifacts/release-bundle/

# sdrscan reports are around 6 MB per scan and are regenerated on demand, so
# they are treated like any other scanner output: not committed. Continuous
# integration uploads them as build artifacts instead. The scan is
# deterministic, so anyone can reproduce a report exactly from a given commit.
validation/reports/sdrscan/

# A live mutelist suppresses findings and belongs to a specific deployment, so
# it stays local. Copy mutelist.example.json to start one.
automation/sdrscan/mutelist.json

# Collector test fixtures are generated from botocore service models by
# generate_fixtures.py at whatever scale a run wants (a 5000-finding Security
# Hub payload is ~68 MB), so the payloads are regenerated on demand, not
# committed. The generator and MANIFEST.json ARE committed, so any run is
# reproducible: `python automation/collectors/generate_fixtures.py --scale N`.
automation/collectors/testdata/*.json
!automation/collectors/testdata/MANIFEST.json

# ASH (Automated Security Helper) scan output is generated and regenerated on
# demand; never commit it. The .ash.yaml config IS committed (it is source).
.ash/

# AI narrative-draft sidecar is a proposed copy derived from account facts;
# it is a review artifact, never the source of truth. Not committed.
sdr/records/records-store.ai-draft.json

# Bandit report written by audit/release_gate.py (uploaded as a CI artifact).
bandit-report.txt
# Machine-readable release-gate results (AUD-F66): run output of
# audit/release_gate.py, uploaded as a CI artifact per section. Never committed:
# a gate result is evidence of a run, not a generated deliverable.
validation/reports/gate-results.json
validation/reports/gate-results.run.json

# Class-matrix validation reports for the INACTIVE classes (AUD-F23) are
# regenerated by every validate run; the committed reports describe the active class.
validation/reports/matrix/
